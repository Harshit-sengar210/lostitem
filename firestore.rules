rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ─────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'k7AgEIzGQHbBxnekS26POn4602x2';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ─── USERS COLLECTION ────────────────────────────────────────
    // Anyone can read profiles; owners or Admin can manage them.
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // ─── ITEMS COLLECTION (Lost & Found Listings) ─────────────────
    // Public read; reporters/finders or Admin can edit & delete.
    match /items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.reporterId == request.auth.uid ||
          resource.data.finderId == request.auth.uid ||
          !('reporterId' in resource.data)
        )
      );
    }

    // ─── NOTIFICATIONS COLLECTION ────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ─── CLAIMS / RECOVERIES COLLECTION ──────────────────────────
    match /recoveries/{recoveryId} {
      allow read, write: if isSignedIn();
    }

    // ─── FALLBACK ACCESS ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin() || isSignedIn();
    }
  }
}
